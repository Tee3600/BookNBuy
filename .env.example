# Local-first: Postgres via Docker Compose, app via `npm run dev`. No Supabase, no Vercel.
DATABASE_URL="postgresql://booknbuy:booknbuy@localhost:5432/booknbuy?schema=public"
APP_URL="http://localhost:3000"

# Better Auth (email+password now, SMS/WhatsApp OTP next)
BETTER_AUTH_SECRET="change-me-in-dev-min-32-chars"

# Cloudflare R2 (S3-compatible) for product / dispute photos
R2_ACCOUNT_ID="xxx"
R2_ACCESS_KEY_ID="xxx"
R2_SECRET_ACCESS_KEY="xxx"
R2_BUCKET="booknbuy-dev"
R2_PUBLIC_URL="https://pub-xxx.r2.dev"

PAYSTACK_SECRET_KEY="sk_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxx"
PAYSTACK_WEBHOOK_SECRET="whsec_xxx"
COMMISSION_PRODUCT_BPS=800
COMMISSION_SERVICE_BPS=1000
ESCROW_RELEASE_HOURS=72

# Phase 6: set to lock admin mutations behind x-admin-key header
ADMIN_KEY=""

# Phase 5 notifications (optional): Termii sender + key; unset = log-only
TERMI_SENDER="BookNBuy"
TERMI_API_KEY=""
